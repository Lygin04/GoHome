<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Одно имя на всё: каталог репозитория, решение, проект, сборка, namespace и exe.
             Расхождение здесь ломает не сборку, а поиск: IDE ищет решение по имени папки,
             скрипты установки — exe по имени сборки. -->
        <RootNamespace>GoHome</RootNamespace>
        <AssemblyName>GoHome</AssemblyName>
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
        <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
        <!-- Иконка проводника и панели задач. Вшивается в apphost на этапе сборки,
             поэтому переживает и однофайловую публикацию: бандл несёт готовый apphost. -->
        <ApplicationIcon>Resources\gohome.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!-- Тот же файл нужен и в рантайме — окнам и трею до первой отрисовки кольца.
             Именно ресурсом сборки: рядом с однофайловым exe никаких файлов не лежит. -->
        <EmbeddedResource Include="Resources\gohome.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- Тестам нужны паузы между попытками записи: с боевыми они ждали бы секундами. -->
        <InternalsVisibleTo Include="GoHome.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Ставится на корпоративную машину без прав на установку рантайма. -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <!-- WinForms не поддерживает тримминг: предупреждения сборки и падения на рефлексии. -->
        <PublishTrimmed>false</PublishTrimmed>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- Символы внутрь exe, а не отдельным .pdb: пользователь присылает один файл журнала
             ошибок, и в трассировке видны файл и строка. Расплата — пути сборочной машины
             в стеке; это осознанно. Убрать их, сохранив номера строк, можно через PathMap. -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <Product>GoHome</Product>
        <AssemblyTitle>GoHome</AssemblyTitle>
        <Description>Учёт отработанного времени с автоматической паузой по блокировке экрана</Description>
        <!-- Версия не хардкодится: её задаёт релизный workflow из тега (-p:Version=1.2.0). -->
    </PropertyGroup>

</Project>